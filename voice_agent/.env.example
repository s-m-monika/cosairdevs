# ─────────────────────────────────────────────────────────────────────────────
# FRAB Voice Escalation Agent — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Vapi (get these from https://dashboard.vapi.ai) ──────────────────────────
# Private API key — server-side ONLY. Never expose in frontend / React code.
VAPI_API_KEY=

# The Assistant you created: "FRAB Voice Escalation Agent"
VAPI_ASSISTANT_ID=

# The phone number ID shown after you import your Twilio number into Vapi
# (Dashboard -> Phone Numbers -> Import Twilio)
VAPI_PHONE_NUMBER_ID=

# ── Twilio (needed only when importing the number into Vapi) ─────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── FRAB backend (source of the completed investigation / case data) ─────────
# Local dev:  http://localhost:8000
# Production: https://YOUR-SYNTHETIC-BANK-CLOUD-RUN-URL
FRAB_BACKEND_URL=http://localhost:8000

# ── Vapi webhook (public URL Vapi POSTs call-status events to) ───────────────
# Local dev: use an ngrok tunnel, e.g. https://abcd1234.ngrok.io/api/voice/webhook
# Production: https://YOUR-VOICE-AGENT-CLOUD-RUN-URL/api/voice/webhook
VAPI_WEBHOOK_URL=

# ── Service ──────────────────────────────────────────────────────────────────
# Port to run on. Cloud Run overrides this automatically.
PORT=8001

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed frontend origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
