# ─────────────────────────────────────────────────────────────────────────────
# Synthetic Bank — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# Never commit a .env file containing real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Cloud ──────────────────────────────────────────────────────────────
# Your GCP project ID (e.g. frab-507310).
GOOGLE_CLOUD_PROJECT=your-project-id

# Firestore database name.  Use "(default)" unless you created a named database.
FIRESTORE_DATABASE=(default)

# Set to "true" to enable Firestore reads/writes.
# Leave "false" for purely in-memory / CSV-backed local development.
USE_FIRESTORE=false

# ── Server ────────────────────────────────────────────────────────────────────
# Port the uvicorn server listens on.
# Cloud Run overrides this automatically — do not hardcode in production.
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# localhost:8080 is included so a local frontend can call the Cloud Run backend.
# Add your deployed frontend URL here for production.
# Do NOT use * for production deployments.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080

# ── Local Firestore emulator (optional) ───────────────────────────────────────
# Uncomment to point the Firestore client at a local emulator instead of GCP.
# FIRESTORE_EMULATOR_HOST=localhost:8081
